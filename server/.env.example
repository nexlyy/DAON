# Copy to server/.env and fill in. The .env file is gitignored — the token
# never belongs in the repository or in the site build, which is public.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Where reservations are sent. Leave empty and send /start to the bot instead:
# the service prints the id and remembers it in server/data/chat.json.
TELEGRAM_CHAT_ID=

# Port the notifier listens on.
PORT=8787

# The site's origin, for CORS. "*" while testing.
ALLOWED_ORIGIN=https://nexlyy.github.io

# Optional shared string the site sends as X-Daon-Secret. It is visible in the
# published build, so it only raises the bar for drive-by posts — the rate
# limit is what actually holds.
NOTIFY_SECRET=

# Set to 0 to stop answering /start (long polling).
TELEGRAM_LISTEN=1
