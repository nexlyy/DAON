# Copy to server/.env and fill in. The .env file is gitignored — the token
# never belongs in the repository or in the site build, which is public.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# The Telegram accounts that may use the bot, comma separated. Every
# reservation goes to each of them, and nobody else gets an answer. These are
# numeric user ids, not usernames: a username can be dropped and claimed by a
# stranger, an id cannot. Each person has to open the bot and press Start once
# before it can write to them. The service will not start with this empty.
TELEGRAM_STAFF_IDS=

# Supabase. Without these the reservations go into server/data/bookings.json,
# which is fine for a trial run and nothing else. The service key is a
# server-only secret: it bypasses row level security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Port the API listens on. nginx proxies to it; it is not exposed directly.
PORT=8787

# Origins allowed to call the API, comma separated. Add a dev server while
# working on the site.
ALLOWED_ORIGIN=https://daon.pl,http://localhost:5173

# Set to 0 to stop answering /start (long polling).
TELEGRAM_LISTEN=1

# Guest emails: a confirmation with a calendar file, a reminder the day before,
# and a note when the booking is changed or cancelled. Leave these empty and the
# site does not ask for an email at all. With Gmail: turn on 2-Step Verification
# for the account, create an app password (Google Account > Security > App
# passwords) and paste it here. The connection is TLS on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=DAON Korean Restaurant

# The admin panel at /admin, where the restaurant edits its own menu, hours and
# wording. These two set it up the first time and nothing more: the panel opens
# read-only and the only thing it will do is take a new password, which is then
# kept as a scrypt hash in data/admin.json. Leave them empty and /admin answers
# nothing at all.
ADMIN_USER=
ADMIN_PASSWORD=

# Staff who should not get the admin panel's messages — signing in, publishing,
# a blocked address. Comma separated Telegram ids. They still get everything
# about the bookings. Leave empty and everyone gets everything.
ADMIN_QUIET_IDS=
