# Point this at a reservation backend to replace the in-browser demo adapter.
# Leaving it unset keeps the site fully static, which is what GitHub Pages needs.
# VITE_BOOKING_API_URL=https://api.example.com/v1

# Where reservations are announced. The small service in server/ holds the bot
# token and forwards each booking to the restaurant's Telegram; without this the
# site simply does not announce anything.
# VITE_BOOKING_NOTIFY_URL=https://notifier.example.com
# VITE_BOOKING_NOTIFY_SECRET=
